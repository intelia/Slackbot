SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token
PORT=3000

ZUPA_API=https://your-zupa-api-base-url
ZUPA_API_TOKEN=your-zupa-bearer-token


# AI_PROVIDER selects which AI segments raw order text: "openai" (default) or "claude"
AI_PROVIDER=openai

OPENAI_API_KEY=sk-proj-CW.........lrptTL0A
OPENAI_MODEL=gpt-4o-mini

# Claude uses OpenRouter when OPENROUTER_API_KEY is set; an unqualified
# CLAUDE_MODEL is routed as anthropic/<model>.
OPENROUTER_API_KEY=
# If OPENROUTER_API_KEY is unset, Claude uses the direct Anthropic API instead.
ANTHROPIC_API_KEY=sk-ant-........
CLAUDE_MODEL=claude-sonnet-5
# Only for direct Anthropic Console keys that span multiple workspaces.
ANTHROPIC_WORKSPACE_ID=
