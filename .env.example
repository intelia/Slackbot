SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token
PORT=3000

ZUPA_API=https://your-zupa-api-base-url
ZUPA_API_TOKEN=your-zupa-bearer-token


# AI_PROVIDER selects which AI segments raw order text: "openai" (default) or "claude"
AI_PROVIDER=openai

OPENAI_API_KEY=sk-proj-CW.........lrptTL0A
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=sk-ant-........
CLAUDE_MODEL=claude-sonnet-5
# Only needed if ANTHROPIC_API_KEY is an identity-linked Console key (spans multiple
# workspaces) rather than a workspace-scoped key — Anthropic will 400 with
# "anthropic-workspace-id is required" until this is set to the target workspace's id.
ANTHROPIC_WORKSPACE_ID=
